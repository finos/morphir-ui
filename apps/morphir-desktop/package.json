{
  "name": "@morphir/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "eslint src test",
    "typecheck:main": "../../packages/morphir-ir/node_modules/.bin/tsc -p tsconfig.node.json --noEmit",
    "typecheck": "bun run typecheck:main && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "smoke": "electron-vite build && MORPHIR_SMOKE=1 electron .",
    "package": "electron-vite build && electron-builder --publish=never"
  },
  "dependencies": {
    "@morphir/ir": "workspace:*",
    "@morphir/ui": "workspace:*",
    "effect": "^3.22.1",
    "smol-toml": "^1.8.0",
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.2.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "bun-types": "^1.4.0",
    "@types/node": "^26.4.0"
  }
}
